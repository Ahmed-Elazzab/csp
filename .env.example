# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://csp_user:csp_pass@localhost:5432/csp_db

# ── OpenAI (optional – enables AI-assisted web extraction) ────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Research settings ──────────────────────────────────────────────────────────
SEARCH_MAX_RESULTS=5
CONFIDENCE_THRESHOLD=0.70
# SerpAPI key – more reliable than DuckDuckGo in WSL / cloud environments
# Get a free key at https://serpapi.com (100 searches/month free)
SERPAPI_KEY=

# ── Excel source file (relative to project root) ───────────────────────────────
EXCEL_PATH=data/Critical Parts Attributes.xlsx
