# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://csp_user:csp_pass@localhost:5432/csp_db

# ── OpenAI (optional – enables AI-assisted web extraction) ────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Research settings ──────────────────────────────────────────────────────────
SEARCH_MAX_RESULTS=5
CONFIDENCE_THRESHOLD=0.70
# Tavily – recommended AI-native search API (best results for part look-ups)
# Free tier: 1,000 searches/month – get a key at https://app.tavily.com
TAVILY_API_KEY=tvly-your-key-here
# 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
# SerpAPI – alternative, more reliable than DuckDuckGo on restricted networks
# Free tier: 100 searches/month – get a key at https://serpapi.com
SERPAPI_KEY=
# Hard timeout in seconds for ALL search attempts combined (0 = no timeout)
SEARCH_TIMEOUT=12

# ── Excel source file (relative to project root) ───────────────────────────────
EXCEL_PATH=data/Critical Parts Attributes.xlsx
