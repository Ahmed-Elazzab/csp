########################################
# NWC Spare Part Criticality Assessment
# Environment Configuration
########################################

########################################
# LLM Configuration
########################################

# Provider: openai | azure_openai | anthropic | gemini | ollama | openai_compatible
LLM_PROVIDER=openai

LLM_API_KEY=

LLM_MODEL=gpt-4o-mini

LLM_BASE_URL=https://api.openai.com/v1

# Azure OpenAI only
LLM_API_VERSION=

LLM_ORGANIZATION=

LLM_PROJECT=

LLM_TEMPERATURE=0.1

LLM_MAX_TOKENS=4096

LLM_TIMEOUT=120

LLM_MAX_RETRIES=3

########################################
# Search Configuration
########################################

# Provider used first if configured; falls back automatically
# Recommended: tavily (AI-native, 1 000 free/month → app.tavily.com)
SEARCH_PROVIDER=tavily

SEARCH_MAX_RESULTS=10

SEARCH_TIMEOUT=30

#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
TAVILY_API_KEY=

SERPAPI_KEY=

########################################
# Embeddings (Future RAG)
########################################

EMBEDDING_PROVIDER=openai

EMBEDDING_MODEL=text-embedding-3-large

EMBEDDING_API_KEY=

########################################
# Vector Database (Future)
########################################

VECTOR_DB_PROVIDER=

VECTOR_DB_URL=

VECTOR_DB_API_KEY=

VECTOR_DB_COLLECTION=

########################################
# Observability
########################################

ENABLE_TRACING=false

LOG_LLM_REQUESTS=false

LOG_LLM_RESPONSES=false

########################################
# Database
########################################

DATABASE_URL=postgresql://csp_user:csp_pass@localhost:5432/csp_db

########################################
# Excel (historical compatibility)
########################################

EXCEL_PATH=data/Critical Parts Attributes.xlsx
